# Copy to .env (gitignored) for local runs: `set -a; source .env; set +a`
# On CAI, set these as project environment variables instead.
HF_HOME=.hf_cache
# Air-gapped: an internal Hugging Face mirror (or set features.backbone to a local folder)
# HF_ENDPOINT=https://hf-mirror.internal.example

# Offline run on synthetic films with the stub embedder
# CXR_CONFIG_OVERLAY=config/ci.yaml

# GitHub Actions secrets (repo Settings > Secrets and variables > Actions), not project variables:
# CAI_URL=https://ml-xxxx.<env>.cloudera.site
# CAI_API_KEY=                 # API v2 key of a service user: User Settings > API Keys (never commit)
# CAI_PROJECT_ID=
# CAI_CA_BUNDLE=               # path to the workbench CA certificate on a self-hosted runner

# serve/test_endpoint.py against the deployed model
# CXR_ENDPOINT_URL=https://modelservice.ml-xxxx.<env>.cloudera.site/model
# CXR_ENDPOINT_ACCESS_KEY=     # model Settings
# CXR_ENDPOINT_API_KEY=        # Model API key (authentication on)
