             "http_path": "cliservice", "auth_mechanism": "LDAP", "insert_chunk": 500},
  "dataviz_url": "https://viz-indianbank-spend-analytics.dw-federal-cdp-env.dp5i-5vkq.cloudera.site",
  "dataviz_connection": "federal-impala-1",

  "seed": 20260928,
  "first_date": "2026-09-28",
