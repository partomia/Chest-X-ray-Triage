  "sources": {
    "ris": {"entity": "ris_order", "format": "psv", "file": "orders_{date}.psv"},
    "pacs": {"entity": "pacs_study", "format": "jsonl", "file": "studies_{date}.jsonl"},
    "reports": {"entity": "radiology_report", "format": "jsonl", "file": "reports_{date}.jsonl"},
    "emr": {"entity": "emr_patient", "format": "csv", "file": "patients_{date}.csv"}
  },
  "contracts": {
    "ris_order": {"key": "accession_no", "columns": [
      {"name": "accession_no", "type": "string", "required": true},
      {"name": "mrn", "type": "string", "required": true},
      {"name": "order_ts", "type": "timestamp", "required": true},
      {"name": "ordering_unit", "type": "string", "required": true, "values": ["ED", "OPD", "WARD", "ICU"]},
      {"name": "clinical_priority", "type": "string", "required": true, "values": ["STAT", "URGENT", "ROUTINE"]},
      {"name": "indication", "type": "string", "required": false},
      {"name": "procedure_code", "type": "string", "required": true}]},
    "pacs_study": {"key": "StudyInstanceUID", "columns": [
      {"name": "StudyInstanceUID", "type": "string", "required": true},
      {"name": "AccessionNumber", "type": "string", "required": true},
      {"name": "PatientID", "type": "string", "required": true},
      {"name": "Modality", "type": "string", "required": true, "values": ["CR", "DX"]},
      {"name": "ViewPosition", "type": "string", "required": false, "values": ["PA", "AP", "LL"]},
      {"name": "BodyPartExamined", "type": "string", "required": true, "values": ["CHEST"]},
      {"name": "StationName", "type": "string", "required": false},
      {"name": "Manufacturer", "type": "string", "required": false},
      {"name": "StudyDate", "type": "date8", "required": true},
      {"name": "StudyTime", "type": "time6", "required": true},
      {"name": "ImageFile", "type": "string", "required": true},
      {"name": "Rows", "type": "int", "required": false},
      {"name": "Columns", "type": "int", "required": false}]},
    "radiology_report": {"key": "accession_no", "columns": [
      {"name": "accession_no", "type": "string", "required": true},
      {"name": "report_ts", "type": "timestamp", "required": true},
      {"name": "radiologist_id", "type": "string", "required": true},
      {"name": "finding", "type": "string", "required": true, "values": ["PNEUMONIA", "NORMAL"]},
      {"name": "pattern", "type": "string", "required": false, "values": ["bacterial", "viral"]},
      {"name": "impression", "type": "string", "required": true}]},
    "emr_patient": {"key": "mrn", "columns": [
      {"name": "mrn", "type": "string", "required": true},
      {"name": "given_name", "type": "string", "required": true},
      {"name": "family_name", "type": "string", "required": true},
      {"name": "birth_date", "type": "date", "required": true},
      {"name": "sex", "type": "string", "required": true, "values": ["F", "M"]}]}
  }
}
